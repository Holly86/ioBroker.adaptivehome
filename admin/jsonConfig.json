{
  "i18n": true,
  "type": "panel",
  "items": {
    "notice": {
      "type": "staticText",
      "text": {
        "en": "Configure rooms, devices, rules and learning in the Adaptive Home Admin tab. No cloud account is required.",
        "de": "Räume, Geräte, Regeln und Lernen werden im Admin-Tab Adaptive Home eingerichtet. Ein Cloudkonto ist nicht erforderlich."
      }
    },
    "integrationProfiles": {
      "allowEmpty": true,
      "validateJson": true,
      "type": "jsonEditor",
      "xs": 12,
      "newLine": true,
      "label": {
        "de": "Vertrauenswürdige Herstellerprofile (SDK v1, optional)",
        "en": "Trusted integration profiles (SDK v1, optional)"
      }
    },
    "controlClients": {
      "xs": 12,
      "label": {
        "en": "Optional trusted control clients",
        "de": "Optionale vertrauenswürdige Bedienclients"
      },
      "type": "jsonEditor",
      "newLine": true
    },
    "controlSecret": {
      "xs": 12,
      "label": {
        "en": "Optional gateway signing secret",
        "de": "Optionaler Signaturschlüssel für ein Gateway"
      },
      "type": "password",
      "newLine": true
    },
    "modelProvider": {
      "newLine": true,
      "type": "jsonEditor",
      "xs": 12,
      "allowEmpty": true,
      "label": {
        "en": "Optional model provider (explicit scope and budgets)",
        "de": "Optionaler Modellanbieter (Umfang und Budgets ausdrücklich einrichten)"
      }
    },
    "modelToken": {
      "newLine": true,
      "type": "password",
      "xs": 12,
      "label": {
        "en": "Optional model-provider token",
        "de": "Optionales Zugangstoken des Modellanbieters"
      }
    }
  }
}
